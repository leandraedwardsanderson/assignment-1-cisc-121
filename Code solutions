#Intro
print("--- FROG CROSSING SIMULATOR ---\n\n\tHelp this small frog get to the other side of the road!\n\nFor each value, input it as a integer between 1 - 1,000,000\n\nX should be less than or equal to Y.")

#starting values for the input goes into the error checking loops
X = -1
Y = -1
D = -1

#error checking range for starting position
while X < 1 or X > 1000000:
  try:
    X = int(input ("\nPlease input the starting position of the frog: "))#user inputs the starting position value
  except ValueError:
